#!/bin/sh
# Project C code compiles warning-free under strict flags (design section
# 14; roadmap Stage 1). The check first compiles a planted warning and
# requires it to fail, since -fsyntax-only alone exits 0 on warnings: a gate
# is trusted once it has been seen to fail. Run from the package root.
set -eu

CC=${CC:-cc}
RINC=$(Rscript -e 'cat(R.home("include"))')
ZUFAST=$(tools/zufast-include)
ZUBIN=${ZUBIN_INC:-$(Rscript -e 'cat(system.file("include", package = "zubin"))')}
FLAGS="-std=gnu17 -DNDEBUG -Wall -Wextra -Wpedantic -Wshadow -Wstrict-prototypes -Werror -fsyntax-only"
# R's and the providers' headers are -isystem: the gate is for zunpy's code.
# R 4.6's R_ext/Boolean.h uses a C23 enum form that -Wpedantic rejects in
# gnu17 (zucbor and zujson met it too).
INC="-isystem $RINC -isystem $ZUFAST -isystem $ZUBIN -Isrc"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int znp_lint_canary(void) { int unused; return 0; }\n' > "$WORK/canary.c"
if $CC $FLAGS "$WORK/canary.c" 2>/dev/null; then
  echo "FAIL: the lint gate accepted a planted warning" >&2
  exit 2
fi

fail=0
for f in src/*.c; do
  extra=""
  # init.c casts each entry point to DL_FUNC, the registration idiom Writing
  # R Extensions prescribes; -Wextra's function-cast check rejects it.
  [ "$f" = src/init.c ] && extra="-Wno-cast-function-type"
  # shellcheck disable=SC2086
  $CC $FLAGS $extra $INC "$f" || fail=1
done
# The R-free build of the check phase, as the fuzzer and probe compile it.
for f in src/znp_header.c fuzz/*.c; do
  # shellcheck disable=SC2086
  $CC $FLAGS -DZNP_STANDALONE -isystem "$ZUFAST" -Isrc "$f" || fail=1
done
[ $fail = 0 ] || { echo "FAIL: warnings in project C code" >&2; exit 1; }
echo "==> project C code is warning-free under $FLAGS"
