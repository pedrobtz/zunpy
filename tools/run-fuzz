#!/bin/sh
# libFuzzer over the R-free check phase (roadmap Stage 1). Usage, from the
# package root:
#
#   tools/run-fuzz [seconds]        default 60
#   CANARY_ONLY=1 tools/run-fuzz    only prove the canary crashes (CI fuzzes
#                                   through r-actions' fuzz.yml)
#
# The canary (fuzz_header.c built with -DZNP_FUZZ_CANARY, which traps on any
# accepted input) must crash first, through the same harness and flags, or
# the gate is not trusted: zuxml's fuzz gate once passed every run because it
# tested a pipe's exit status (zuxml #35). The grown corpus is kept in
# $FUZZ_CORPUS (default fuzz/corpus). Needs a clang with libFuzzer: Apple's
# has none, so on macOS set FUZZ_CC=/opt/homebrew/opt/llvm/bin/clang.
set -eu

SECS=${1:-60}
CC=${FUZZ_CC:-clang}
CORPUS=${FUZZ_CORPUS:-fuzz/corpus}
INC=$(tools/zufast-include)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int LLVMFuzzerTestOneInput(const unsigned char *d, unsigned long n) { (void) d; (void) n; return 0; }\n' > "$WORK/probe.c"
if ! $CC -fsanitize=fuzzer "$WORK/probe.c" -o "$WORK/probe" 2>/dev/null; then
  echo "run-fuzz: $CC has no libFuzzer runtime; set FUZZ_CC to one that does" >&2
  exit 2
fi

FLAGS="-std=gnu17 -g -O1 -fno-omit-frame-pointer -fsanitize=fuzzer,address,undefined
       -fno-sanitize-recover=undefined -UNDEBUG -DZNP_STANDALONE -Isrc -I$INC"
# shellcheck disable=SC2086
$CC $FLAGS -DZNP_FUZZ_CANARY fuzz/fuzz_header.c src/znp_header.c -o "$WORK/canary"
# shellcheck disable=SC2086
$CC $FLAGS fuzz/fuzz_header.c src/znp_header.c -o "$WORK/fuzz_header"

# 1. The canary must crash. The exit status is the binary's own, never a
# pipe's.
if "$WORK/canary" -runs=100000 -artifact_prefix="$WORK/canary-" fuzz/seeds > "$WORK/canary.log" 2>&1; then
  echo "FAIL: the canary did not crash; the fuzz gate cannot be trusted" >&2
  exit 2
fi
ls "$WORK"/canary-* > /dev/null 2>&1 || { echo "FAIL: the canary exited without a crash artifact" >&2; tail "$WORK/canary.log" >&2; exit 2; }
echo "==> canary crashed, as it must"
[ "${CANARY_ONLY:-}" = 1 ] && exit 0

# 2. The target, for SECS seconds, over the corpus and the seeds.
mkdir -p "$CORPUS" "$WORK/artifacts"
status=0
"$WORK/fuzz_header" -max_total_time="$SECS" -max_len=65536 -dict=fuzz/npy.dict \
  -artifact_prefix="$WORK/artifacts/" "$CORPUS" fuzz/seeds > "$WORK/fuzz.log" 2>&1 || status=$?
tail -3 "$WORK/fuzz.log"
if [ "$status" != 0 ] || [ -n "$(ls -A "$WORK/artifacts")" ]; then
  echo "FAIL: fuzz_header found a crash (exit $status)" >&2
  mkdir -p fuzz/artifacts && cp "$WORK/artifacts"/* fuzz/artifacts/ 2>/dev/null || true
  exit 1
fi
echo "==> fuzz_header: ${SECS}s, no finding; corpus now $(ls "$CORPUS" | wc -l | tr -d ' ') inputs"
